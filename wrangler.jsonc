{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-fe",
  "main": "dist/server/server.js",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "QUIZ_BE",
      "service": "quiz-be"
    }
  ]
}
